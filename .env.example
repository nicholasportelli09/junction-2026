# Copy to .env.local and fill in. Never commit .env.local (this repo is public).
# Reasoning model: mock | nvidia | verda | gemini (see context/architecture.md)
# Teammates without keys: set MODEL_PROVIDER=mock and leave every key empty.
MODEL_PROVIDER=mock
# Optional backup that takes over if the main model errors or stays silent for 2 s (e.g. verda with nvidia behind it).
MODEL_FALLBACK=
# off = fast conversation turns (0.54 s to first token); on = slow planning tasks
NEMOTRON_THINKING=off
# Nemotron 3.5 Super VL through any OpenAI-compatible endpoint (Verda vLLM or https://integrate.api.nvidia.com/v1)
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional: a smaller model for the tool-choice step only (saves about 0.15 s). Leave empty to use Super VL throughout.
NEMOTRON_FAST_MODEL=
# Nemotron self-hosted on Verda (see deploy/verda/README.md). Reached through an SSH tunnel.
VERDA_BASE_URL=http://127.0.0.1:18000/v1
VERDA_API_KEY=
VERDA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GEMINI_API_KEY=
EXA_API_KEY=
EXA_SEARCH_TYPE=lite
CONTEXT_DEV_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_STT_LANGUAGE=en
ELEVENLABS_VOICE_ID=
# --- Hosting (optional; leave all of these out on the booth laptop). See section 16 of docs/FRONTEND_INTEGRATION_CONTRACT.md.
# State in Supabase, one row per visitor. Run deploy/supabase/sisu_sessions.sql once in the project first.
SUPABASE_URL=
# The server's key: the secret key if you have it, otherwise the publishable key. Set one of the two.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# The server's own password for the two database functions (see deploy/supabase/sisu_sessions.sql). Without it
# anyone who has the address and the publishable key could call them. Never give it to a frontend.
SISU_STORE_TOKEN=
# file | supabase. Unset: supabase when the two settings above are present, otherwise the file.
SISU_STORE=
# visitor | shared. Unset: visitor with Supabase, shared with the file.
SISU_SESSIONS=
# Who may call the API from another address: * or a comma-separated list of origins.
SISU_CORS_ORIGINS=
# Needed to reset the one shared state on a deployed site (sent as the x-sisu-reset-token header).
SISU_RESET_TOKEN=
